# Firebase Configuration
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# Paste the private key as-is (with literal \n) or base64-encode it for container envs
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# Optional — only needed if you use Firebase Storage
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# AWS S3 Configuration (media uploads — presigned POST)
AWS_REGION=us-east-1
# Only needed for local/manual use without an AWS profile. In deployed
# environments, infra provides credentials via IAM role — leave these unset.
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=testifyhub-prod-media-838029584630
# Public base URL for the bucket (or CloudFront domain if fronted by a CDN), no trailing slash
AWS_S3_PUBLIC_BASE_URL=https://testifyhub-prod-media-838029584630.s3.us-east-1.amazonaws.com
