# Firebase Configuration
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# Paste the private key as-is (with literal \n) or base64-encode it for container envs
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
# Optional — only needed if you use Firebase Storage
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# AWS S3 Configuration (media uploads — presigned POST)
AWS_REGION=us-east-1
# Only needed for local/manual use without an AWS profile. In deployed
# environments, infra provides credentials via IAM role — leave these unset.
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_S3_BUCKET=testifyhub-prod-media-838029584630

# Public base URL for stored media, no trailing slash.
#
# This MUST be the CloudFront domain, never the bucket's own S3 endpoint.
#
# The bucket is private: all four public-access blocks are on, and its policy
# grants s3:GetObject to the cloudfront.amazonaws.com service principal alone
# (Origin Access Control). CloudFront is the only reader there is. Verified:
#
#   https://testifyhub-prod-media-...s3.us-east-1.amazonaws.com/<key>  -> 403
#   https://cdn.testifyhub.co/<key>                                    -> 200
#
# Point this at the S3 endpoint and every public_url the presign endpoint
# returns is a dead link — the upload succeeds, the URL is stored against the
# post or profile, and the image 403s for every viewer. Nothing fails loudly.
AWS_S3_PUBLIC_BASE_URL=https://cdn.testifyhub.co
